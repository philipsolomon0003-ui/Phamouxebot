# Local Dashboard Server
HOST=127.0.0.1
PORT=8080
DEBUG=false

# Security & Session Authentication
# Set a unique secret string to sign local operator session cookies
PHAMOUXE_SECRET_KEY=enter-a-random-secure-secret-key-here

# Telegram Contact for Famous Media Technologies
TELEGRAM_CONTACT=@Phamouxetv

# ---------------------------------------------------------------------
# Official Discord OAuth2 & Bot Credentials
# Obtain from https://discord.com/developers/applications
# IMPORTANT: Never enter personal account tokens. Use official Bot/OAuth2 credentials only.
# ---------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------
# AI Intelligence Provider (Optional)
# The application includes high-quality deterministic response engines by default.
# To enable live Gemini LLM messaging, provide your Gemini API key below:
# ---------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=builtin

